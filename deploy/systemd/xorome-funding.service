[Unit]
Description=xorome funding check (watch treasury address, log new transfers)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/xorome
EnvironmentFile=/opt/xorome/.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/npm run check-funding
TimeoutStartSec=120
User=xorome
Group=xorome
StandardOutput=journal
StandardError=journal
