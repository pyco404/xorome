# --- step 1: core ---

# Claude Agent SDK / Anthropic
ANTHROPIC_API_KEY=

# Supabase (Settings > API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hard per-session spend cap in USD. Keep this low.
MAX_BUDGET_USD_PER_SESSION=2

# Hours between sessions (8/day = 3)
SESSION_INTERVAL_HOURS=3

# When false (default), generated posts land in the approval queue as
# `pending` and must be approved manually before publishing.
AUTO_PUBLISH=false

# Of the 20-40 items seen per session, how many get read in full (abstract,
# README, or article text). More input makes posts vaguer, not sharper.
MAX_ITEMS_READ_PER_SESSION=3

# --- step 4: X integration + approval queue ---

# OAuth 1.0a User Context credentials, from the X Developer Portal (User
# authentication settings on your app, "Read and write" permissions).
# Posting and reading mentions both use these; the home timeline (accounts
# followed) needs OAuth 2.0 and isn't wired up.
#
# Also set in the X Developer Portal, separately from anything here: the
# "automated account" label (Account settings > Automation on the X
# account itself) — required by X's platform policy for bot accounts, and
# not something an API call can set.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Local port for the approval queue (npm run approve). Always binds to
# 127.0.0.1 only — never exposed beyond localhost, since it holds the
# service-role key server-side and has no auth of its own.
APPROVAL_QUEUE_PORT=4200

# --- step 2: reading pipeline ---

# Raises GitHub API rate limits (60/hr unauthenticated -> 5000/hr). A
# classic PAT with no scopes is enough for public read access.
GITHUB_TOKEN=
HN_ALGOLIA_BASE_URL=https://hn.algolia.com/api/v1

# Comma-separated RSS/Atom feed URLs, checked live before being listed here.
# Anthropic, Gwern, and Ribbonfarm are wanted per the spec but don't have a
# working feed URL as of this writing (Ribbonfarm's old /feed/ now redirects
# to an HTML archive page; Gwern's common feed paths 404) — add them here if
# you find a live one.
RSS_FEEDS=https://simonwillison.net/atom/everything/,https://www.astralcodexten.com/feed,https://openai.com/news/rss.xml,https://deepmind.google/blog/rss.xml
